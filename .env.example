# ==========================================
# 必填基础配置
# ==========================================

# Telegram Bot Token (从 @BotFather 获取)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# 管理员 Telegram User ID (仅白名单用户允许使用，支持英文逗号分隔多个 ID)
ADMIN_ID=12345678

# 允许使用 Bot 的群组白名单 ID (支持英文逗号分隔多个群组 ID，群组 ID 通常以 -100 开头；留空则仅私聊管理员可用)
ALLOWED_GROUP_IDS=

# Telegram Local Bot API Server 地址 (必须开启 --local 模式以突破 50MB 限制并秒传)
API_BASE=http://127.0.0.1:8081

# 下载与共享挂载目录 (宿主机上的绝对路径)
DOWNLOAD_DIR=/opt/tg-bot-api/temp

# 容器内部对应的挂载路径 (对应 docker-compose 冒号右侧，如无 Docker 映射可留空)
CONTAINER_DOWNLOAD_DIR=/tmp/telegram-bot-api

# ==========================================
# 性能与高级可调参数 (根据机器配置按需调整)
# ==========================================

# 最大并发任务数 (小机器建议 1 避免打满 IO；大机器/大带宽可调大如 3 或 5)
MAX_CONCURRENT_TASKS=1

# 单个下载任务最大超时时间 (例如: 30m, 1h, 2h)
TASK_TIMEOUT=60m

# Telegram 进度推送节流间隔 (防 429 FloodWait，建议 2.5s ~ 5s)
THROTTLE_INTERVAL=3s

# aria2c 单任务最大分片连接数 (默认 16，大带宽可调至 32)
ARIA2_SPLIT=16

# aria2c 写入磁盘缓存大小 (默认 16M，低内存机器可调小如 4M)
ARIA2_DISK_CACHE=16M

# aria2c 文件分配方式 (默认 falloc，极低配置或特殊文件系统可设为 none)
ARIA2_FILE_ALLOC=falloc

# 单文件体积上限拦截 (默认 2000M 匹配 Local API 上限，0 为不设限)
MAX_FILE_SIZE=2000M

# yt-dlp 最高分辨率限制 (默认 0 为不限/拉取最佳画质；低配机器可填 1080 或 720)
YTDL_MAX_HEIGHT=0

# yt-dlp 代理设置 (例如: socks5://127.0.0.1:1080 或 http://proxy:8080，防机房 IP 被 YouTube 封禁)
YTDL_PROXY=

# yt-dlp Cookies 路径 (自动读取同级目录 cookies.txt，防 YouTube "Sign in to confirm you're not a bot" 拦截)
YTDL_COOKIES_FILE=cookies.txt

# 进度推送消息处理 (默认 true: 文件转存成功后自动删除过程进度条消息，聊天界面仅保留最终文件卡片；false 为保留)
DELETE_PROGRESS_MSG=true
