# Telegram Bot Token (从 @BotFather 获取)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# 管理员 Telegram User ID (仅白名单用户允许使用，支持英文逗号分隔多个 ID)
ADMIN_ID=12345678

# Telegram Local Bot API Server 地址 (必须开启 --local 模式)
API_BASE=http://127.0.0.1:8081

# 下载与共享挂载目录 (宿主机上的绝对路径)
# 例如你的 docker-compose 在 /root/tg-api，挂载了 ./temp:/tmp/telegram-bot-api
# 则此处填写宿主机绝对路径: /root/tg-api/temp
DOWNLOAD_DIR=/opt/tg-bot-api/temp

# 容器内部对应的挂载路径 (如果使用 Docker 且宿主机路径与容器内不同)
# 对应 docker-compose 中冒号右边的路径: /tmp/telegram-bot-api
# 如果宿主机与容器路径一致，可留空或保持相同
CONTAINER_DOWNLOAD_DIR=/tmp/telegram-bot-api

# 单个下载任务最大超时时间 (例如: 30m, 1h, 2h)
TASK_TIMEOUT=45m

# Telegram 进度推送节流间隔 (防 429 FloodWait，建议 2.5s ~ 5s)
THROTTLE_INTERVAL=3s

# aria2c 单任务最大分片连接数 (推荐 8 ~ 16)
ARIA2_SPLIT=16
