[Unit]
Description=tgdown - Telegram High-Performance Downloader Bot (Low Memory)
After=network.target telegram-bot-api.service
Wants=telegram-bot-api.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/tgdown
EnvironmentFile=/opt/tgdown/.env
ExecStart=/opt/tgdown/tgdown

Restart=always
RestartSec=5s

Nice=10

[Install]
WantedBy=multi-user.target
